# 맥에서 빌드한 파일 하나만 복사해서 실행합니다.
#   CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o requestguard ./cmd/requestguard
#   ./requestguard
#
# 계정 페이지에서 발급한 키만 넣습니다. 가입 확인 링크는 키가 아닙니다.
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# 0.0.0.0 이면 루프백을 제외한 이 기기의 주소마다 엽니다.
# all 이면 1-65535를 검사하고, 접속한 포트 번호 그대로 아래 앱 주소로 넘깁니다.
# 앱은 127.0.0.1에만 바인드하세요.
LISTEN_HOST=0.0.0.0
LISTEN_PORTS=all
LISTEN_PORT=8080

UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3000

ABUSE_SCORE_THRESHOLD=75
TRUST_COUNTRIES=KR,JP
TRUST_SCORE_THRESHOLD=90
TRUST_RATE_LIMIT_PER_SEC=60
MIXED_COUNTRIES=US
LOW_SCORE_THRESHOLD=25
LOW_RATE_LIMIT_PER_SEC=10

BAN_DAYS=30
MAX_BAN_DAYS=365
RATE_LIMIT_PER_SEC=30
WHITELIST=
